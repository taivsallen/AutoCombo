{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ComboAuto",
  "version": "0.0.0",
  "identifier": "com.comboauto.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build:tauri",
    "devUrl": "http://127.0.0.1:5173/AutoCombo/",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ComboAuto",
        "width": 430,
        "height": 820,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
